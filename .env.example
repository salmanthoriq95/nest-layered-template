NODE_ENV=development
HOST=127.0.0.1
PORT=3000
JWT_SIGNING_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=nest-layered-template
JWT_AUDIENCE=nest-layered-template-api
SWAGGER_ENABLED=true
SWAGGER_USERNAME=REPLACE_WITH_YOUR_USERNAME
SWAGGER_PASSWORD_HASH=REPLACE_WITH_YOUR_BCRYPT_HASH
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REFRESH_RATE_LIMIT_MAX_REQUESTS=30
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_CLEANUP_INTERVAL_SECONDS=60
SWAGGER_RATE_LIMIT_MAX_REQUESTS=60
SWAGGER_RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_ADDRESSES=
LOG_WORKER_URL=http://127.0.0.1:3001/internal/logs
LOG_WORKER_HOST=127.0.0.1
LOG_WORKER_PORT=3001
LOG_WORKER_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
LOG_WORKER_TIMEOUT_MS=1000
LOG_WORKER_MAX_CONCURRENT_REQUESTS=10
LOG_QUEUE_CAPACITY=100
LOG_MAX_EVENT_BYTES=16384
LOG_SHUTDOWN_TIMEOUT_MS=5000
LOG_ERROR_DIRECTORY=./logs/errors
LOG_ERROR_RETENTION_DAYS=7
LOG_ERROR_MAX_FILE_BYTES=10485760
